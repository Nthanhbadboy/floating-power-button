<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground Service (review issue #4): declared, but NEVER started
         until the user confirms the in-app explanation dialog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Boot restore (PC v2 parity): BootCompletedReceiver only resumes
         the Keep-Alive service when the user previously enabled it in the
         app; it never starts anything on a fresh install. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- No INTERNET permission is requested by the app itself; ad SDKs add
         their own if/when they are integrated. -->

    <application
        android:label="Power &amp; Volume"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name="com.floatingbutton.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher long-press shortcuts (PC v2 parity). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Accessibility: instant lock via GLOBAL_ACTION_LOCK_SCREEN.
             It never reads screen content (see accessibility_service_config). -->
        <service
            android:name="com.floatingbutton.app.PowerAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Keep-Alive Foreground Service: user-enabled only (default OFF).
             specialUse subtype explains the persistent Lock/Volume
             notification to Google Play / AppGallery reviewers. -->
        <service
            android:name="com.floatingbutton.app.KeepAliveForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled persistent notification with Lock Screen and Volume shortcuts that keeps the accessibility lock feature available." />
        </service>

        <!-- Optional fallback screen lock. Never wipes data. -->
        <receiver
            android:name="com.floatingbutton.app.PowerDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- LOCK / VOLUME actions on the persistent notification. -->
        <receiver
            android:name="com.floatingbutton.app.NotificationActionReceiver"
            android:exported="false" />

        <!-- Restores the user-enabled Keep-Alive service after reboot or
             app update (PC v2 parity). Gated by the persisted in-app
             opt-in; starts nothing on a fresh install. -->
        <receiver
            android:name="com.floatingbutton.app.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile: Lock Screen (PC v2 parity). -->
        <service
            android:name="com.floatingbutton.app.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_lock"
            android:label="@string/tile_lock_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Volume panel (PC v2 parity). -->
        <service
            android:name="com.floatingbutton.app.VolumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_volume"
            android:label="@string/tile_volume_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Google AdMob (fallback banner). TEST App ID — replace with the
             production AdMob App ID before release, together with
             AppInfo.adMobBannerAdUnitId. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
